{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --import tsx --watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "smoke": "tsx scripts/smoke.ts",
    "tuya:check": "tsx scripts/tuya-check.ts",
    "provision:unit": "tsx scripts/provision-unit.ts",
    "smoke:units": "tsx scripts/smoke-units.ts",
    "smoke:automations": "tsx scripts/smoke-automations.ts",
    "smoke:integrations": "tsx scripts/smoke-integrations.ts",
    "seed": "tsx scripts/seed.ts",
    "gen:key": "tsx scripts/gen-key.ts",
    "smoke:onboarding": "tsx scripts/smoke-onboarding.ts"
  },
  "dependencies": {
    "@domotique/contract": "*",
    "@fastify/cors": "^10.0.2",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^6.2.1",
    "fastify": "^5.2.1",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.18.1",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "~6.0.3",
    "vitest": "^2.1.9"
  }
