# Backend — variables d'environnement (CDC §10).
# Aucune de ces valeurs ne doit approcher apps/mobile : tout ce qui y est lisible
# par l'app est inliné en clair dans le bundle.

# PostgreSQL. DIRECT_URL sert aux migrations : derrière un pooler (Neon,
# pgBouncer), Prisma Migrate ne peut pas passer par la connexion poolée.
DATABASE_URL="postgresql://domotique:domotique@localhost:5432/domotique?schema=public"
DIRECT_URL="postgresql://domotique:domotique@localhost:5432/domotique?schema=public"

# État chaud + pub/sub + fenêtre de rejeu des événements (§6.4, §9).
# Vide = store en mémoire, pour le développement sur une seule instance.
REDIS_URL=""

# Signature des jetons applicatifs. Deux secrets distincts : un refresh token
# volé ne doit pas pouvoir être présenté comme un access token.
JWT_SECRET="dev-only-change-me-0000000000000000"
JWT_REFRESH_SECRET="dev-only-change-me-1111111111111111"
ACCESS_TOKEN_TTL_S="900"
REFRESH_TOKEN_TTL_S="2592000"

# Chiffrement au repos des tokens OAuth tiers (§7). 32 octets en base64.
# Rotation : plusieurs clés séparées par des virgules, « version:clé ». On
# chiffre toujours avec la version la plus haute, on déchiffre avec n'importe
# laquelle — les anciennes lignes restent lisibles le temps du réencryptage.
#   TOKEN_ENCRYPTION_KEY="1:ancienneCle=,2:nouvelleCle="
# En production : coffre-fort de secrets, jamais une variable d'environnement.
# Générer la vôtre :  npm run gen:key --workspace api
TOKEN_ENCRYPTION_KEY="REMPLACER_PAR_UNE_CLE_GENEREE"

# Projet cloud Tuya (§10) — laissés vides tant que le connecteur n'existe pas.
TUYA_ACCESS_ID=""
TUYA_ACCESS_SECRET=""
TUYA_DATA_CENTER="https://openapi-weaz.tuyaeu.com"   # « Western Europe » de la console

# Broker MQTT des boîtiers (§2). Vide = connecteur Zigbee désactivé.
# 0 = scrutation désactivée. Consomme le quota Tuya : à n'activer que pour tester.
TUYA_POLL_INTERVAL_S="0"

MQTT_BROKER_URL=""

PUBLIC_URL="http://localhost:3000"
# Schéma de l'app en développement ; URL déclarée chez le fournisseur en production.
OAUTH_REDIRECT_URI="domotique://oauth"
PORT="3000"
NODE_ENV="development"
