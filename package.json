{
  "name": "domotique",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "mobile": "npm run start --workspace mobile",
    "api": "npm run dev --workspace api",
    "db:migrate": "npm run db:migrate --workspace api",
    "tuya:check": "npm run tuya:check --workspace api",
    "seed": "npm run seed --workspace api",
    "smoke": "npm run smoke --workspace api"
  },
  "engines": {
    "node": ">=20"
  }
}
